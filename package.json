{
  "name": "wowgpt",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "Claude in World of Warcraft: chat with Claude Code and other local coding agents (Codex, Grok Build, Antigravity, Hermes) from inside World of Warcraft: Forever or Classic Era, with no UI reloads. Pixel strip out, load-on-demand slots in.",
  "license": "MIT",
  "author": "chelinho139",
  "repository": {
    "type": "git",
    "url": "https://github.com/rdimascio/wowgpt"
  },
  "keywords": [
    "world-of-warcraft",
    "wow-addon",
    "wowgpt",
    "claude-code",
    "claude",
    "codex",
    "grok",
    "coding-agent",
    "bridge"
  ],
  "engines": {
    "node": ">=22.2"
  },
  "bin": {
    "wowgpt": "bridge/supervisor.js"
  },
  "files": [
    "bridge/*.js",
    "bridge/plugins/*.js",
    "bridge/capture.ps1",
    "bridge/capture_mac.py",
    "bridge/capture_x11.py",
    "bridge/config.example.json",
    "bridge/game-phrases.json",
    "bridge/order-words.json",
    "bridge/roast-words.json",
    "bridge/simitems.json",
    "bridge/simweights.json",
    "bridge/start-window.cmd",
    "bridge/start.ps1",
    "addon/WoWGPT/**/*.lua",
    "addon/WoWGPT/WoWGPT.toc",
    "addon/WoWGPT/Bindings.xml",
    "addon/WoWGPT/*.tga",
    "assets/plugins/wowgpt/.claude-plugin/plugin.json",
    "assets/plugins/wowgpt/agents/*.md",
    "setup.js",
    "build.js",
    "dev/contract-mcp.js",
    "docs/AGENTS.md",
    "docs/CONFIGURATION.md",
    "docs/IN-GAME-DEV.md",
    "docs/INSTALL.md",
    "docs/INSTALL-LINUX.md",
    "docs/INSTALL-WINDOWS.md",
    "docs/LIVE-SESSION.md",
    "docs/MAP.md",
    "docs/OPERATING-NOTES.md",
    "docs/UI-WIDGETS.md",
    "docs/WOW-ADDON-PRIMER.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "setup": "node setup.js",
    "start": "node bridge/supervisor.js",
    "slots": "node bridge/install-slots.js",
    "dev": "node dev/cli.js",
    "doctor": "node dev/doctor.js",
    "audit:widgets": "node dev/widget-audit.js",
    "pack:check": "node dev/pack-check.js",
    "prepublishOnly": "node dev/pack-check.js --publish",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "lint:lua": "luacheck addon/WoWGPT && stylua --check addon/WoWGPT",
    "format": "oxfmt && oxlint --fix && stylua addon/WoWGPT",
    "test": "node tests/unit.js",
    "test:bun": "bun tests/unit.js",
    "test:coverage": "node tests/unit.js --experimental-test-coverage --test-coverage-include=bridge/** --test-coverage-include=setup.js --test-coverage-include=build.js --test-coverage-lines=90 --test-coverage-branches=82.5 --test-coverage-functions=89",
    "test:e2e": "node --test --test-concurrency=3 --test-timeout=180000 --test-reporter=spec tests/e2e/*_test.js",
    "test:fuzz": "node --test --test-reporter=spec tests/e2e/fuzz_test.js",
    "check": "npm run lint && npm test && npm run test:e2e",
    "test:live": "node tests/inject_test.js",
    "test:live-session": "node tests/live_session_test.js",
    "build": "node build.js",
    "probe": "python3 bridge/capture_x11.py --probe bridge/probe.png",
    "probe:mac": "python3 bridge/capture_mac.py --probe bridge/probe.png",
    "check:mac": "python3 bridge/capture_mac.py --check"
  },
  "devDependencies": {
    "fengari": "^0.1.4",
    "luaparse": "^0.3.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0"
  },
  "dependencies": {
    "@chat-adapter/discord": "4.41.1",
    "@chat-adapter/state-memory": "4.41.1",
    "chat": "4.41.1"
  }
}
